# ============================================================================
# Dzhar.dev — Environment configuration
# Copy to .env and fill in. NEVER commit the real .env file.
# ============================================================================

# --- Application -------------------------------------------------------------
APP_ENV=development                       # development | production
APP_PORT=8080
APP_BASE_URL=http://localhost:8080
FRONTEND_ORIGIN=http://localhost:5173     # allowed CORS origin during dev

# --- PostgreSQL --------------------------------------------------------------
# You can supply either DATABASE_URL, or the discrete POSTGRES_* fields below.
DATABASE_URL=postgres://dzhar:dzhar@localhost:5432/dzhar_dev?sslmode=disable
POSTGRES_USER=dzhar
POSTGRES_PASSWORD=dzhar
POSTGRES_DB=dzhar_dev
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Admin bootstrap ---------------------------------------------------------
# Used ONLY by `make seed-admin` / the bootstrap command to create the first
# admin. The password is hashed with bcrypt before it ever touches the DB.
ADMIN_BOOTSTRAP_NAME=Dzhar
ADMIN_BOOTSTRAP_EMAIL=admin@dzhar.dev
ADMIN_BOOTSTRAP_PASSWORD=change-me-before-first-run

# --- Session / security ------------------------------------------------------
# 32+ byte random string. Generate with: openssl rand -hex 32
SESSION_SECRET=please-generate-a-random-32-byte-secret
SESSION_COOKIE_NAME=dzhar_session
SESSION_TTL_HOURS=168
COOKIE_SECURE=false                       # true when served over HTTPS
LOGIN_RATE_LIMIT_PER_MIN=5
CONTACT_RATE_LIMIT_PER_MIN=5

# --- GitHub integration ------------------------------------------------------
# Public repository data works without a token (rate limited to 60 req/hour).
# A token raises the limit to 5000 req/hour. It MUST stay server-side only.
GITHUB_USERNAME=zharrDev
GITHUB_TOKEN=
GITHUB_CACHE_TTL_MINUTES=30
GITHUB_REQUEST_TIMEOUT_SECONDS=10

# --- Uploads -----------------------------------------------------------------
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5

# --- Email (optional) --------------------------------------------------------
# When SMTP_HOST is empty, contact messages are only stored in PostgreSQL.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@dzhar.dev
CONTACT_NOTIFY_TO=admin@dzhar.dev

# --- Frontend (build-time) ---------------------------------------------------
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_SITE_URL=http://localhost:5173
VITE_GITHUB_USERNAME=zharrDev
